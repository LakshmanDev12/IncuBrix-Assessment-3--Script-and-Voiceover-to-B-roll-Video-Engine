# ==============================================================================
# Script and Voiceover to B-roll Video Engine - Environment Configuration
# ==============================================================================
# Copy this file to .env and replace placeholder values with your real configuration.
# NEVER commit real API keys, credentials, or private secrets to version control.

# --- Core Directories & Storage ---
OUTPUT_DIR=output

# --- Media Provider Credentials ---
# Pexels API Key: Obtain from https://www.pexels.com/api/
# Required only if ENABLE_REMOTE_PROVIDERS=true.
PEXELS_API_KEY=your_pexels_api_key_here

# Set to 'true' to allow querying external remote APIs (Pexels, etc.).
# When 'false', the engine strictly uses the verified offline local CC0 archive.
ENABLE_REMOTE_PROVIDERS=false

# Default provider: 'local_cc0', 'pexels', or 'composite'
DEFAULT_MEDIA_PROVIDER=local_cc0

# --- Network & SSRF Security ---
ALLOW_PRIVATE_NETWORKS=false
URL_FETCH_TIMEOUT_SECONDS=5.0
MAX_URL_REDIRECTS=3

# --- Segmentation & Pacing Defaults ---
DEFAULT_WORDS_PER_MINUTE=150
MIN_WORDS_PER_SCENE=2
TARGET_WORDS_PER_SCENE=18
MAX_WORDS_PER_SCENE=45

# --- Job & Media Constraints ---
MIN_SCENE_DURATION_SECONDS=0.5
MAX_SCENE_DURATION_SECONDS=60.0
MIN_JOB_DURATION_SECONDS=1.0
MAX_JOB_DURATION_SECONDS=300.0
MAX_AUDIO_FILE_SIZE_BYTES=52428800
MAX_AUDIO_DURATION_SECONDS=300.0
